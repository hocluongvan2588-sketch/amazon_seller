# ============================================================
# Amazon Internal Operations Platform — environment variables
# ============================================================
# Copy this file to `.env.local` and fill in real values.
# WITHOUT Supabase credentials the app runs in DEMO MODE
# (in-memory sample data, clearly labeled in the UI).

# --- Supabase (production mode) ---
# Project URL: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Anon public key (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: service role key. ONLY used server-side for admin jobs.
# Never expose to the browser. Leave empty when unsure.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (optional) ---
# OpenAI-compatible endpoint. When empty, the platform falls back to the
# built-in deterministic heuristic engine (evidence-based, no external calls).
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL_NAME=
